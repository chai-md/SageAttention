+# Opt-in hook for benchmarking Sol-Attn on models that do not ask for it: checkpoints
+# normally select it per module via their `config` tensor ("comfy_kitchen_sol"), which
+# non-VSA-trained models such as MiniMax-H3 do not carry.  With COMFY_SOL_ATTN=1 every
+# module that has no config (and no other per-module backend) is routed to Sol-Attn at
+# COMFY_SOL_TAU.  Off by default; the kernels only accept head_dim 128 in bf16/fp16 and
+# attention_comfy_kitchen_sol falls back to the dense path for anything else.
+SOL_ATTN_FORCED = os.environ.get("COMFY_SOL_ATTN", "").strip().lower() not in ("", "0", "false", "off", "no")
+try:
+    SOL_ATTN_TAU = float(os.environ.get("COMFY_SOL_TAU", "1.0") or 1.0)
+except ValueError:
+    SOL_ATTN_TAU = 1.0
